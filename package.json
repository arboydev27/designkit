{
  "name": "designkit",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs tests/*.test.ts",
    "prebuild": "node scripts/generate-briefs.mjs && npm run generate:kits",
    "generate:kits": "node --import tsx scripts/generate-kits.mts",
    "check:kits": "npm run generate:kits && node --import tsx scripts/check-kits.mts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "motion": "^14.1.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
